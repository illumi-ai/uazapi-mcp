# Servidor uazapi da sua conta, sem barra no final (obrigatorio)
UAZAPI_SERVER=https://suaempresa.uazapi.com

# Token de administrador do servidor: lista instancias e resolve o token de cada
# uma pelo nome. Painel uazapi -> configuracoes do servidor.
UAZAPI_ADMIN_TOKEN=

# Alternativa ao admin token: token de UMA instancia, quando voce so tem acesso a ela.
UAZAPI_TOKEN=

# Opcional: instancia usada quando a chamada nao informa `instance`.
UAZAPI_DEFAULT_INSTANCE=

# Opcional: transcricao de audios com ElevenLabs Scribe v2.
# Sem esta chave os audios sao baixados, mas nao transcritos.
ELEVENLABS_API_KEY=

# Opcional: onde gravar as midias baixadas (default ~/.uazapi-mcp/media)
UAZAPI_MCP_MEDIA_DIR=

# Opcional: tetos por chamada
UAZAPI_MCP_MAX_MENSAGENS=3000
UAZAPI_MCP_MAX_TRANSCRICOES=30
UAZAPI_MCP_MAX_DOWNLOADS=60
